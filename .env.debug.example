# ====================================
# DEBUG FLAGS CONFIGURATION
# ====================================
# Descomenta/modifica las siguientes variables según necesites

# Activar modo debug completo (muestra todo)
# DEBUG_MODE=true

# Mostrar logs verbosos en consola
# DEBUG_VERBOSE=true

# Incluir bandera de debug en la respuesta HTTP
# DEBUG_INCLUDE_IN_RESPONSE=true

# Mostrar solo información resumida de completitud
# DEBUG_SUMMARY_ONLY=true

# Guardar logs en archivo (requiere DEBUG_MODE=true)
# DEBUG_FILE_LOGGING=true
# DEBUG_LOG_FILE=./logs/debug-flags.log

# ====================================
# DEBUG FLAGS ESPECÍFICAS
# ====================================
# Mostrar información específica:

# DEBUG_SHOW_COMPLETENESS=true      # Mostrar porcentaje de completitud del contexto
# DEBUG_SHOW_MESSAGE=true            # Mostrar detalles del mensaje
# DEBUG_SHOW_PLAYER_CONTEXT=true     # Mostrar detalles del contexto del jugador
# DEBUG_SHOW_CSS_SNAPSHOT=true       # Mostrar detalles del CSS
# DEBUG_SHOW_CONVERSATION_ID=true    # Mostrar ID de conversación
# DEBUG_SHOW_INTENT_MODE=true        # Mostrar modo de intención
# DEBUG_SHOW_MISSING_FIELDS=true     # Mostrar campos faltantes

# ====================================
# USO
# ====================================
# 1. Para desarrollo local - usa esta línea:
#    DEBUG_MODE=true
#
# 2. Para producción con debug selectivo:
#    DEBUG_SHOW_MISSING_FIELDS=true
#    DEBUG_SHOW_COMPLETENESS=true
#
# 3. Para debug en request específico (sin variable de entorno):
#    Envía header: X-Debug: true
